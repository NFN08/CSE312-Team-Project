# Optional for local runs: compose.yaml has local defaults.
# For any shared or deployed environment, copy this file to .env and change the password.
POSTGRES_DB=tank_battle_arena
POSTGRES_USER=tank_user
POSTGRES_PASSWORD=change-this-local-password

# Auth server: JWT lifetime in seconds (sets the "exp" claim).
JWT_TTL_SECONDS=86400
# auto = add the cookie Secure flag when the request arrived over HTTPS (X-Forwarded-Proto).
# Set to true on the HTTPS deployment.
COOKIE_SECURE=auto

# Comma-separated browser origins accepted during the WebSocket handshake.
# Keep localhost for local grading and add the deployed HTTPS origin when needed.
ALLOWED_ORIGINS=http://localhost:8080,https://tankbattle312.duckdns.org

# Objective 4: number of server-side AI bot tanks (0-8; 0 disables them)
# and Monte Carlo tree search iterations per bot decision (20-2000).
BOT_COUNT=3
BOT_SEARCH_ITERATIONS=200
